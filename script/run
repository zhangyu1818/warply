#!/bin/bash

set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
cd "${REPO_ROOT}"

OS_TYPE="$(uname -s)"
if [[ "$OS_TYPE" != "Darwin" ]]; then
  echo "Warply local run is supported only on macOS." >&2
  exit 1
fi

FEATURES="gui"
WARPLY_BIN_NAME="warply"
WARPLY_CHANNEL="oss"
MAC_ARGS=()
WARPLY_ARGS=()

while (( "$#" )); do
  case "$1" in
    --)
      shift
      WARPLY_ARGS=("$@")
      break
      ;;
    --features)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        FEATURES="$FEATURES,$2"
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    --release)
      MAC_ARGS+=("$1")
      shift
      ;;
    --profile)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        MAC_ARGS+=("$1" "$2")
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    *)
      # Unknown flags (including macOS-only flags like --dont-open) and any
      # positional arguments are forwarded to the platform-specific script.
      MAC_ARGS+=("$1")
      shift
      ;;
  esac
done

export FEATURES
export WARPLY_BIN_NAME
export WARPLY_CHANNEL

if [[ ${#WARPLY_ARGS[@]} -gt 0 ]]; then
  exec ./script/macos/run "${MAC_ARGS[@]}" -- "${WARPLY_ARGS[@]}"
else
  exec ./script/macos/run "${MAC_ARGS[@]}"
fi
