#!/bin/bash

set -euo pipefail

tag="${1:?release tag is required}"
field="${2:?version field is required}"

if [[ "$tag" =~ ^v([0-9]{4})\.([0-9]{2})\.([0-9]{2})(\.([0-9]+))?$ ]]; then
  year="${BASH_REMATCH[1]}"
  month="${BASH_REMATCH[2]}"
  day="${BASH_REMATCH[3]}"
  build="${BASH_REMATCH[5]:-}"
else
  echo "Unsupported Warply release tag '$tag'. Expected vYYYY.MM.DD or vYYYY.MM.DD.N." >&2
  exit 1
fi

case "$field" in
  short)
    printf '%s.%s.%s\n' "$year" "$month" "$day"
    ;;
  bundle)
    if [[ -n "$build" ]]; then
      printf '%s%s%s.%s\n' "$year" "$month" "$day" "$build"
    else
      printf '%s%s%s\n' "$year" "$month" "$day"
    fi
    ;;
  *)
    echo "Unsupported version field '$field'. Expected short or bundle." >&2
    exit 1
    ;;
esac
