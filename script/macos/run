#!/bin/bash

set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../.. && pwd)"
cd "${REPO_ROOT}"

: "${WARPLY_BIN_NAME:?WARPLY_BIN_NAME must be set (invoke via ./script/run)}"
: "${WARPLY_CHANNEL:?WARPLY_CHANNEL must be set (invoke via ./script/run)}"
: "${FEATURES:?FEATURES must be set (invoke via ./script/run)}"

TARGET_DIR="$(cargo metadata --no-deps --format-version 1 | jq -r .target_directory)"
if [ -z "$TARGET_DIR" ] || [ "$TARGET_DIR" = "null" ]; then
    TARGET_DIR="${REPO_ROOT}/target"
fi

WARPLY_APP_PATH="${TARGET_DIR}/debug/bundle/osx/Warply.app"
WARPLY_SCHEME_NAME="warply"
DONT_OPEN=false
OPEN_WITH_LAUNCHD=false
WARPLY_ARGS=()

export FRAMEWORK_OVERRIDE="dev"

PARAMS=""
while (( "$#" )); do
  case "$1" in
    --)
      shift
      WARPLY_ARGS=("$@")
      break
      ;;
    --dont-open)
      DONT_OPEN=true
      shift
      ;;
    --release)
      echo "Detected release build, pointing at release bundle under ${TARGET_DIR}/release/bundle"
      WARPLY_APP_PATH="${TARGET_DIR}/release/bundle/osx/Warply.app"
      PARAMS="$PARAMS $1"
      shift
      ;;
    --profile)
      PROFILE="$2"
      shift 2
      WARPLY_APP_PATH="${TARGET_DIR}/${PROFILE}/bundle/osx/Warply.app"
      PARAMS="$PARAMS --profile $PROFILE"
      ;;
    --open_with_launchd)
      OPEN_WITH_LAUNCHD=true
      shift
      ;;
    --generate-schema)
      GENERATE_SCHEMA=true
      shift
      ;;
    *) # preserve positional arguments
      PARAMS="$PARAMS $1"
      shift
      ;;
  esac
done

rm -rf "$WARPLY_APP_PATH"

pushd app > /dev/null
echo "Bundling app (bin: $WARPLY_BIN_NAME)..."
cargo bundle --bin "$WARPLY_BIN_NAME" --features "$FEATURES" $PARAMS
echo "Successfully bundled..."
popd > /dev/null

echo "Adding rpath to support mac frameworks"
install_name_tool -add_rpath "@executable_path/../Frameworks" "$WARPLY_APP_PATH/Contents/MacOS/$WARPLY_BIN_NAME"

export WARPLY_SCHEME_NAME
export WARPLY_PLIST_PATH="$WARPLY_APP_PATH/Contents/Info.plist"
./script/update_plist

SPARKLE_DIR="$("${REPO_ROOT}/script/install_sparkle")"
echo "Copying Sparkle.framework into app bundle"
mkdir -p "$WARPLY_APP_PATH/Contents/Frameworks"
ditto "$SPARKLE_DIR/Sparkle.framework" "$WARPLY_APP_PATH/Contents/Frameworks/Sparkle.framework"

echo "Preparing bundled resources..."
if [ "${GENERATE_SCHEMA:-false}" != "true" ]; then
  export SKIP_SETTINGS_SCHEMA=1
fi
NO_LICENSES=1 "${REPO_ROOT}/script/prepare_bundled_resources" "$WARPLY_APP_PATH/Contents/Resources" "$WARPLY_CHANNEL"

"${REPO_ROOT}/script/compile_icon" "$WARPLY_CHANNEL" "$WARPLY_APP_PATH"

if [[ ",$FEATURES," =~ ",heap_usage_tracking," ]]; then
  echo "Bundling pprof..."
  HELPERS_DIR="$WARPLY_APP_PATH/Contents/Helpers"
  "${REPO_ROOT}/script/prepare_bundled_pprof" "$HELPERS_DIR"
fi

echo "Codesigning app..."
SIGNING_CERT="$(security find-identity -p codesigning -v | grep "Apple Development" | awk '{print $2}' | head -1)"
codesign --force --deep --options runtime --sign "${SIGNING_CERT:--}" "$WARPLY_APP_PATH" --entitlements script/Debug-Entitlements.plist

if [ "$DONT_OPEN" = false ] ; then
    if  [ "$OPEN_WITH_LAUNCHD" = true ]; then
        echo "Launching with MacOS application launcher"
        PATH="" /usr/bin/open "$WARPLY_APP_PATH"
        tail -f ~/Library/Logs/warply.log
    else
        echo "Opening app at $WARPLY_APP_PATH/Contents/MacOS/$WARPLY_BIN_NAME"
        "$WARPLY_APP_PATH/Contents/MacOS/$WARPLY_BIN_NAME" "${WARPLY_ARGS[@]}"
    fi
fi
